# Copie para .env e preencha antes de rodar docker compose up
# IMPORTANTE: Nunca commite o arquivo .env com valores reais

DB_USER=
DB_PASSWORD=
DB_NAME=portal_hotel

PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Token de autenticacao para o servico de agentes IA
# BACKEND_BEARER_TOKEN: agentes -> backend (Bearer). AGENTS_API_KEY: backend -> agentes (X-API-Key) e contexto assinado.
# Gere um token seguro: openssl rand -hex 32
BACKEND_BEARER_TOKEN=
AGENTS_API_KEY=
# Chave do provedor compatível com OpenAI; é diferente de AGENTS_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WHATSAPP_AI_ENABLED=false
WHATSAPP_AI_MODEL=gpt-5.6-luna
WHATSAPP_AI_REASONING_EFFORT=medium
# false desabilita mutações do agente durante rollback sem bloquear consultas.
AGENTS_MUTATIONS_ENABLED=true

# Evolution API v2 (desenvolvimento local; não use segredos reais no Git)
EVOLUTION_DB_USER=
EVOLUTION_DB_PASSWORD=
EVOLUTION_API_KEY=
EVOLUTION_API_URL=http://evolution-marazul:8080
EVOLUTION_INSTANCE=marazul
WHATSAPP_ENABLED=false
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_AI_ENABLED=false
EVOLUTION_HOST_PORT=8080

NODE_ENV=development
PORT=5000
# Obrigatório; gere com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=auth_token
CORS_ORIGINS=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portal_hotel
DB_USER=postgres
DB_PASSWORD=

# Integração interna de agentes: gere valores independentes com `openssl rand -hex 32`.
HOTEL_TIMEZONE=America/Sao_Paulo
AGENTS_SERVICE_TOKEN=
AGENTS_API_URL=http://localhost:5051
AGENTS_API_KEY=

# Opcional: cria o primeiro administrador somente quando os dois valores forem preenchidos.
# Use uma senha exclusiva com pelo menos 12 caracteres.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Opcional: cria este usuário da recepção na inicialização se o e-mail ainda não existir.
# `npm run seed` também usa estes valores e substitui os dados de demonstração.
# Use uma senha exclusiva com pelo menos 12 caracteres.
# Uma conta existente não tem a senha alterada.
SEED_RECEPTIONIST_EMAIL=
SEED_RECEPTIONIST_PASSWORD=

# WhatsApp/Evolution: desligado por padrão; credenciais obrigatórias ao ligar.
WHATSAPP_ENABLED=false
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=marazul
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_AI_ENABLED=false
WHATSAPP_AI_DAILY_LIMIT=400
WHATSAPP_RETENTION_MONTHS=12
# Tamanho máximo (bytes) de foto, áudio, vídeo ou documento baixado da Evolution e guardado no banco.
# Acima disso a recepção vê "Arquivo grande demais" e abre no celular. Padrão: 16 MB.
WHATSAPP_MEDIA_MAX_BYTES=16777216
WHATSAPP_PRIVACY_NOTICE=Esta conversa fica registrada no sistema do Hotel Marazul para o seu atendimento.

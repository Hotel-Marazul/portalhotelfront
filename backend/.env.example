NODE_ENV=development
PORT=5000
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=auth_token
CORS_ORIGINS=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portal_hotel
DB_USER=postgres
DB_PASSWORD=

# Opcional: cria o primeiro administrador somente quando os dois valores forem preenchidos.
# Use uma senha exclusiva com pelo menos 12 caracteres.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Obrigatório para `npm run seed`; não use credenciais padrão.
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=

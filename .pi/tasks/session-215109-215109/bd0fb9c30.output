  "reservationConstraints": [
    {
      "conname": "reservations_additional_daily_total_check",
      "definition": "CHECK ((additional_daily_total >= (0)::numeric))"
    },
    {
      "conname": "reservations_base_daily_rate_check",
      "definition": "CHECK ((base_daily_rate > (0)::numeric))"
    },
    {
      "conname": "reservations_client_id_fkey",
      "definition": "FOREIGN KEY (client_id) REFERENCES clients(id) ON UPDATE CASCADE ON DELETE RESTRICT"
    },
    {
      "conname": "reservations_dates_valid",
      "definition": "CHECK ((check_out_date > check_in_date))"
    },
    {
      "conname": "reservations_discount_amount_check",
      "definition": "CHECK ((discount_amount >= (0)::numeric))"
    },
    {
      "conname": "reservations_night_count_check",
      "definition": "CHECK ((night_count > 0))"
    },
    {
      "conname": "reservations_no_overlapping_stays",
      "definition": "EXCLUDE USING gist (room_id WITH =, tstzrange(check_in_date, check_out_date, '[)'::text) WITH &&) WHERE ((status <> 'Cancelada'::text))"
    },
    {
      "conname": "reservations_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "conname": "reservations_price_source_check",
      "definition": "CHECK ((price_source = ANY (ARRAY['catalog'::text, 'manual'::text])))"
    },
    {
      "conname": "reservations_priced_by_fkey",
      "definition": "FOREIGN KEY (priced_by) REFERENCES users(id) ON UPDATE CASCADE ON DELETE SET NULL"
    },
    {
      "conname": "reservations_rate_type_check",
      "definition": "CHECK ((rate_type = ANY (ARRAY['single'::text, 'couple'::text])))"
    },
    {
      "conname": "reservations_room_id_fkey",
      "definition": "FOREIGN KEY (room_id) REFERENCES rooms(id) ON UPDATE CASCADE ON DELETE RESTRICT"
    },
    {
      "conname": "reservations_status_check",
      "definition": "CHECK ((status = ANY (ARRAY['Pendente'::text, 'Confirmada'::text, 'EmAndamento'::text, 'Concluída'::text, 'Cancelada'::text])))"
    },
    {
      "conname": "reservations_subtotal_price_check",
      "definition": "CHECK ((subtotal_price >= (0)::numeric))"
    },
    {
      "conname": "reservations_total_price_check",
      "definition": "CHECK ((total_price >= (0)::numeric))"
    },
    {
      "conname": "reservations_version_check",
      "definition": "CHECK ((version > 0))"
    }
  ]
}

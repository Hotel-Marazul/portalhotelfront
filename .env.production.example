# Copie para .env.production na VPS (nunca commite o arquivo preenchido).
# Gere cada segredo separadamente: openssl rand -hex 32
# Uso: docker compose -f docker-compose.prod.yaml --env-file .env.production up -d --build
#      (com WhatsApp: acrescente --profile whatsapp)

# Domínio comprado, sem https:// e sem app. (o portal fica em app.$DOMAIN)
DOMAIN=
# E-mail para os avisos do Let's Encrypt
ACME_EMAIL=

JWT_SECRET=
JWT_EXPIRES_IN=8h
HOTEL_TIMEZONE=America/Sao_Paulo

DB_NAME=portal_hotel
DB_USER=
DB_PASSWORD=

# Primeiro gerente: preencha na primeira subida e depois apague a senha daqui.
BOOTSTRAP_ADMIN_NAME=Gerente
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

AGENTS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WHATSAPP_AI_MODEL=
WHATSAPP_AI_REASONING_EFFORT=

WHATSAPP_ENABLED=false
WHATSAPP_AI_ENABLED=false
WHATSAPP_AI_DAILY_LIMIT=400
WHATSAPP_RETENTION_MONTHS=12
WHATSAPP_WEBHOOK_SECRET=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=marazul
EVOLUTION_DB_USER=
EVOLUTION_DB_PASSWORD=

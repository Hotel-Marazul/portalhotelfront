NODE_ENV=development
AGENTS_PORT=5050
# Obrigatório; segredo distinto usado pelo gateway e pelo contexto assinado
AGENTS_API_KEY=
RAG_TOP_K=3
RAG_KNOWLEDGE_DIR=

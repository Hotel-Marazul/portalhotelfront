NODE_ENV=development
AGENTS_PORT=5050
BACKEND_BASE_URL=http://localhost:5000/api
# Obrigatório; gere com: openssl rand -hex 32
BACKEND_BEARER_TOKEN=
# Obrigatório; segredo distinto usado pelo gateway e pelo contexto assinado
AGENTS_API_KEY=
BACKEND_TIMEOUT_SECONDS=10
# Desative para rollback imediato das mutações sem interromper consultas/políticas.
AGENTS_MUTATIONS_ENABLED=true
RAG_TOP_K=3
RAG_KNOWLEDGE_DIR=
LOG_FILE_PATH=
AGNO_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Opcional; por padrão usa OPENAI_MODEL.
WHATSAPP_AI_MODEL=
# Para modelos de raciocínio; vazio mantém temperature por tarefa.
WHATSAPP_AI_REASONING_EFFORT=
